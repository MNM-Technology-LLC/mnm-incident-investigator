# Generated local credentials: make setup fills these values without printing them.
TELEMETRY_INGEST_TOKEN=generate-me
DEMO_CONTROL_TOKEN=generate-me

# Compose reaches an Ollama server running on your host. See docs/model-setup.md.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
INVESTIGATION_TIMEOUT_SECONDS=240
CONSOLE_PORT=8080
