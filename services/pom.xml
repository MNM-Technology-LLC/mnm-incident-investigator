<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/>
  </parent>
  <groupId>com.mnm</groupId><artifactId>incident-demo-services</artifactId><version>1.0.0</version><packaging>pom</packaging>
  <name>MNM Incident Investigator demo services</name>
  <description>Synthetic, locally instrumented orders and inventory services.</description>
  <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license></licenses>
  <properties><java.version>21</java.version><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <modules><module>telemetry-common</module><module>orders-service</module><module>inventory-service</module></modules>
  <dependencyManagement><dependencies><dependency><groupId>com.mnm</groupId><artifactId>telemetry-common</artifactId><version>${project.version}</version></dependency></dependencies></dependencyManagement>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource>
        <directory>${project.basedir}/..</directory><targetPath>META-INF</targetPath>
        <includes><include>LICENSE</include><include>NOTICE</include><include>THIRD_PARTY_NOTICES.md</include></includes>
      </resource>
    </resources>
  </build>
</project>
